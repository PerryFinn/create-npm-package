{
  "name": "perryfinn-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Bun workspace monorepo for PerryFinn packages",
  "keywords": [],
  "license": "MIT",
  "author": "PerryFinn <perryfinn@163.com>",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.9",
      "@types/node": "22.18.1",
      "typescript": "^5.9.3"
    },
    "catalogs": {
      "build": {
        "@arethetypeswrong/cli": "^0.18.2",
        "tsdown": "^0.20.3"
      },
      "testing": {
        "@vitest/coverage-v8": "^4.0.18",
        "vitest": "^4.0.18"
      },
      "quality": {
        "@biomejs/biome": "2.4.4"
      }
    }
  },
  "scripts": {
    "build": "bun run --workspaces build",
    "check:exports": "bun run --filter @perryfinn/core check:exports && bun run --filter @perryfinn/utils check:exports",
    "check:type": "bun run --workspaces check:type",
    "ci": "bun run lint && bun run check:type && bun run test && bun run build && bun run check:exports",
    "lint": "bun run --workspaces lint",
    "lint:fix": "bun run --workspaces lint:fix",
    "prepare": "bunx husky",
    "release:publish": "changeset publish",
    "release:version": "changeset version",
    "test": "bun run --workspaces test",
    "test:coverage": "bun run --workspaces test:coverage"
  },
  "lint-staged": {
    "**/package.json": [
      "sort-package-json",
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{css,json,jsonc,graphql,gql}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*": [
      "secretlint"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@changesets/types": "^6.1.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@commitlint/types": "^20.4.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "secretlint": "^11.3.1",
    "sort-package-json": "^3.6.1"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22"
  },
  "volta": {
    "node": "22.19.0"
  }
}
