{
  "name": "@perryfinn/cli",
  "version": "0.1.0",
  "description": "CLI for PerryFinn monorepo",
  "keywords": [],
  "license": "MIT",
  "author": "PerryFinn <perryfinn@163.com>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": {
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "bin": {
    "perryfinn": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check:type": "tsc --noEmit",
    "lint": "biome check . --no-errors-on-unmatched",
    "lint:fix": "biome check --write . --no-errors-on-unmatched",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@perryfinn/utils": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:quality",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:testing",
    "tsdown": "catalog:build",
    "typescript": "catalog:",
    "vitest": "catalog:testing"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
