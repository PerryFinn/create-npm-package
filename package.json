{
  "name": "perryfinn-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Bun workspace monorepo for PerryFinn packages",
  "keywords": [
    "bun",
    "cli",
    "monorepo",
    "npm-package",
    "template",
    "typescript",
    "workspace"
  ],
  "homepage": "https://github.com/PerryFinn/create-npm-package#readme",
  "bugs": {
    "url": "https://github.com/PerryFinn/create-npm-package/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryFinn/create-npm-package.git"
  },
  "license": "MIT",
  "author": "PerryFinn <perryfinn@163.com>",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.14",
      "@types/node": "^24.0.0",
      "typescript": "^7.0.2"
    },
    "catalogs": {
      "build": {
        "@arethetypeswrong/cli": "^0.18.5",
        "tsdown": "^0.22.14"
      },
      "testing": {
        "@vitest/coverage-v8": "^4.1.10",
        "vitest": "^4.1.10"
      },
      "quality": {
        "@biomejs/biome": "^2.5.6"
      }
    }
  },
  "scripts": {
    "build": "bun run --workspaces build",
    "check:exports": "bun run --filter @perryfinn/utils check:exports && bun run --filter @perryfinn/cli check:exports",
    "check:type": "bun run --workspaces check:type",
    "ci": "bun run lint && bun run check:type && bun run test:coverage && bun run build && bun run check:exports",
    "lint": "bun run --workspaces lint",
    "lint:fix": "bun run --workspaces lint:fix",
    "prepare": "bunx husky",
    "release:publish": "changeset publish",
    "release:version": "changeset version",
    "test": "bun run --workspaces test",
    "test:coverage": "bun run --workspaces test:coverage"
  },
  "lint-staged": {
    "**/package.json": [
      "sort-package-json",
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{css,json,jsonc,graphql,gql}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*": [
      "secretlint"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:quality",
    "@changesets/cli": "^2.31.1",
    "@changesets/types": "^6.1.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "secretlint": "^13.0.4",
    "sort-package-json": "^4.0.0",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24.15.0"
  },
  "volta": {
    "node": "24.15.0"
  }
}
