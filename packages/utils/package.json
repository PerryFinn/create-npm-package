{
  "name": "@perryfinn/utils",
  "version": "0.1.0",
  "description": "Utility module for PerryFinn monorepo",
  "keywords": [],
  "license": "MIT",
  "author": "PerryFinn <perryfinn@163.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check:exports": "npm_config_cache=../../.npm-cache attw --pack . --profile=node16",
    "check:type": "tsc --noEmit",
    "lint": "biome check . --no-errors-on-unmatched",
    "lint:fix": "biome check --write . --no-errors-on-unmatched",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:build",
    "@biomejs/biome": "catalog:quality",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:testing",
    "tsdown": "catalog:build",
    "typescript": "catalog:",
    "vitest": "catalog:testing"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
